          "legendFormat": "{{model_name}} TPOT p50",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (model_name, le) (rate(vllm:time_per_output_token_seconds_bucket[5m])))",
          "legendFormat": "{{model_name}} TPOT p95",
          "refId": "B"
        }
      ],
      "title": "Time Per Output Token (TPOT)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
